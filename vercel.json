{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/product-feed.xml",
      "destination": "/api/product-feed"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemaps.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|assets/|favicon|src/|sitemap\\.xml|sitemaps\\.xml|robots\\.txt|prerender-manifest\\.json|.*\\.(?:xml|txt|ico|png|jpg|jpeg|webp|svg|gif|webmanifest|js|css|map)$).*)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
