# =============================================================================
# Research Peptides EU — environment variables
#
# Stack
#   • Frontend: Vite + React (this repo)
#   • Database: Neon (orders + product feed) · Supabase (auth + catalog UI)
#   • Email:    Resend (order + contact notifications via /api/email/*)
#   • Hosting:  Vercel (static app + serverless api/*)
#
# Setup
#   1. Copy this file to `.env` and fill in values (never commit `.env`).
#   2. Local UI only:        npm run dev
#   3. Local UI + API/email: vercel dev   (loads .env for api routes + Resend)
#   4. Production:           Vercel → Project → Settings → Environment Variables
#
# Vercel variable rules
#   • VITE_*     → embedded in the browser build (public). Anon key + tawk.to IDs only.
#   • No VITE_   → server-only (api/*, scripts). Service role + Resend API key here.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — frontend (required for npm run dev / Vite build)
# Dashboard → Project Settings → API → Project URL + anon public key
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"


# -----------------------------------------------------------------------------
# Supabase — server & scripts (required for /api/* and npm run db:seed:supabase)
# Same Project URL as above + service_role key (secret — never VITE_)
# Used by: auth (JWT verify), admin role checks, catalog seed scripts.
# Orders themselves are stored in Neon (DATABASE_URL) — see below.
# Check GET /api/email/health after deploy.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# Neon Postgres — canonical store for orders (+ product feed)
# Required on Vercel for /api/orders and /api/email/* order lookups.
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Optional — legacy UK/previous Supabase (for npm run db:copy:catalog:apply)
# Dashboard → old project → Settings → API → service_role (never commit real keys)
# SOURCE_SUPABASE_URL="https://old-project.supabase.co"
# SOURCE_SUPABASE_SERVICE_ROLE_KEY="old-service-role-key"


# -----------------------------------------------------------------------------
# Site URL (Vercel production domain — used in product feed, email links)
# Set to your Vercel URL or custom domain, e.g. https://researchpeptide.eu
# -----------------------------------------------------------------------------
SITE_URL="https://your-app.vercel.app"


# -----------------------------------------------------------------------------
# Resend — transactional email (required for order + contact emails on Vercel)
# https://resend.com → API Keys + verify sending domain for RESEND_FROM
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Research Peptides EU <noreply@your-verified-domain.com>"
EMAIL_ADMIN_TO="admin@your-verified-domain.com"
EMAIL_BRAND_NAME="Research Peptides EU"
EMAIL_SUPPORT_ADDRESS="support@your-verified-domain.com"

# Optional
# EMAIL_FROM="same as RESEND_FROM if you prefer an alias"
# EMAIL_DRY_RUN="true"
# RESEND_BASE_URL="https://api.resend.com"


# -----------------------------------------------------------------------------
# Admin access hint (frontend only — DB role must still be admin in Supabase)
# See server/migrations/003_admin_rls_orders_products.sql
# -----------------------------------------------------------------------------
# VITE_ADMIN_EMAILS="you@example.com"


# -----------------------------------------------------------------------------
# tawk.to live chat (optional — browser)
# Dashboard → Administration → Channels → Chat Widget → embed code
# URL format: https://embed.tawk.to/{PROPERTY_ID}/{WIDGET_ID}
# -----------------------------------------------------------------------------
# VITE_TAWK_PROPERTY_ID="your_property_id"
# VITE_TAWK_WIDGET_ID="your_widget_id"
# Or single value: VITE_TAWK_EMBED_ID="property_id/widget_id"
# Lift default widget above mobile bottom nav (px) if you show tawk's bubble in dashboard
# VITE_TAWK_MOBILE_OFFSET_Y="88"


# -----------------------------------------------------------------------------
# Manual Bitcoin checkout (optional override; default address is coded in-app)
# -----------------------------------------------------------------------------
# BTC_PAYMENT_ADDRESS="bc1qzsn5djk2pklr49hepvpu4ckzwj9tujkxtdlqma"


# -----------------------------------------------------------------------------
# Local dev only (optional)
# -----------------------------------------------------------------------------
# VITE_DEV_API_PROXY="http://127.0.0.1:3000"
# VITE_SITE_URL="http://localhost:5173"
